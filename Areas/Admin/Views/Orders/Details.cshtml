@model Order
@{
    ViewData["Title"] = "تفاصيل الطلب";
}

<h3 class="mb-4">تفاصيل الطلب #@Model.OrderID</h3>

<div class="admin-table-card p-4 mb-4">
    <p><strong>العميل:</strong> @Model.CustomerName — @Model.CustomerPhone</p>
    <p><strong>المنتج:</strong> @Model.Product?.Name</p>
    <p><strong>الإجمالي:</strong> @Model.TotalAmount.ToString("N0") جنيه</p>
</div>

@if (Model.Installments.Any())
{
    <h5 class="mb-3">جدول الأقساط</h5>
    <div class="table-responsive admin-table-card">
        <table class="table align-middle">
            <thead>
                <tr><th>القسط</th><th>تاريخ الاستحقاق</th><th>المبلغ</th><th>الحالة</th></tr>
            </thead>
            <tbody>
                @foreach (var inst in Model.Installments.OrderBy(i => i.InstallmentNumber))
                {
                    <tr>
                        <td>@inst.InstallmentNumber</td>
                        <td>@inst.DueDate.ToString("dd/MM/yyyy")</td>
                        <td>@inst.Amount.ToString("N0") جنيه</td>
                        <td>
                            @if (inst.IsPaid)
                            {
                                <span class="badge text-bg-success">مدفوع</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">مستحق</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
