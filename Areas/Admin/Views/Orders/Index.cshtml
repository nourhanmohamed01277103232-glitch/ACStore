@model List<Order>
@{
    ViewData["Title"] = "المبيعات";
}

<h3 class="mb-4">إدارة المبيعات</h3>

<div class="table-responsive admin-table-card">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>العميل</th>
                <th>المنتج</th>
                <th>التاريخ</th>
                <th>طريقة الدفع</th>
                <th>الإجمالي</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>@o.CustomerName <br /><small class="text-muted">@o.CustomerPhone</small></td>
                    <td>@o.Product?.Name</td>
                    <td>@o.OrderDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (o.PaymentType == PaymentType.Cash)
                        {
                            <span class="badge text-bg-success">كاش</span>
                        }
                        else
                        {
                            <span class="badge text-bg-info">تقسيط</span>
                        }
                    </td>
                    <td>@o.TotalAmount.ToString("N0") جنيه</td>
                    <td><a asp-action="Details" asp-route-id="@o.OrderID" class="btn btn-sm btn-outline-secondary">التفاصيل</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
