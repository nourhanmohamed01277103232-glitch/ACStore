<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - لوحة التحكم</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/admin.css" rel="stylesheet" />
</head>
<body class="admin-body">
    <div class="admin-layout">
        <aside class="admin-sidebar">
            <div class="admin-logo">❄️ ACStore <span class="admin-tag">Admin</span></div>
            <nav class="admin-nav">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">🏠 الرئيسية</a>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index">📦 المخزون</a>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index">🧾 المبيعات</a>
                <a asp-area="Admin" asp-controller="Audit" asp-action="Index">📅 المراجعة الشهرية</a>
                <a asp-area="Admin" asp-controller="Account" asp-action="Logout" class="logout-link">🚪 تسجيل الخروج</a>
            </nav>
        </aside>
        <main class="admin-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
