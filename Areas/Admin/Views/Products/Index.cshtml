@model List<Product>
@{
    ViewData["Title"] = "إدارة المخزون";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">إدارة المخزون</h3>
    <a asp-action="Create" class="btn btn-order-cta">+ إضافة منتج جديد</a>
</div>

<div class="table-responsive admin-table-card">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>المنتج</th>
                <th>النوع</th>
                <th>السعر</th>
                <th>الكمية</th>
                <th>الحالة</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr class="@(p.StockQuantity <= 3 ? "row-low-stock" : "")">
                    <td>@p.Name</td>
                    <td>@(p.Type == ProductType.AirConditioner ? "تكييف" : "فلتر مياه")</td>
                    <td>@p.Price.ToString("N0") جنيه</td>
                    <td>@p.StockQuantity</td>
                    <td>
                        @if (p.StockQuantity == 0)
                        {
                            <span class="badge text-bg-danger">نفذ</span>
                        }
                        else if (p.StockQuantity <= 3)
                        {
                            <span class="badge text-bg-warning">قليل</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">متاح</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@p.ProductID" class="btn btn-sm btn-outline-secondary">تعديل</a>
                        <form asp-action="Delete" asp-route-id="@p.ProductID" method="post" class="d-inline" onsubmit="return confirm('متأكدة من الحذف؟')">
                            <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
